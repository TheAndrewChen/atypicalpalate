---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props { title?: string; description?: string }
const {
  title = 'A Typical Palate · Everyday favorites. Extraordinary finds.',
  description = "Boston-rooted food and travel finds: Michelin and 50 Best picks, the everyday spots worth returning to, and eating out with a kid in tow.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e1413" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="A Typical Palate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@700&display=swap" />
    <!-- Google AdSense site tag, carried over unchanged from the previous site -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1728923629901328" crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip { position: absolute; left: 8px; top: -48px; z-index: 50; padding: 8px 12px; background: var(--color-surface); border-radius: var(--radius-button); }
  .skip:focus { top: 8px; }
</style>
