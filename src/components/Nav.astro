---
// Sticky, fully opaque top bar. On phones the links fold into a native <details> menu (no JavaScript).
import Icon from './Icon.astro';
const links = [
  { label: 'Finds', href: '/#finds' },
  { label: 'Boston list', href: '/#list' },
  { label: 'What I write about', href: '/#pillars' },
  { label: 'Follow', href: '/#follow' },
];
---
<header class="bar">
  <nav class="container inner" aria-label="Main">
    <a class="wordmark" href="/">A Typical Palate</a>
    <ul class="links">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <details class="menu">
      <summary><Icon name="menu" />Menu</summary>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </details>
  </nav>
</header>

<style>
  .bar { position: sticky; top: 0; z-index: 20; background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-16); min-height: 68px; }
  .links { display: flex; gap: var(--space-32); list-style: none; margin: 0; padding: 0; }
  .links a { text-underline-offset: 4px; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 0 var(--space-12); border: 1px solid var(--color-border-strong); border-radius: var(--radius-button); font-weight: 600; cursor: pointer; color: var(--color-text); }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { border-color: var(--color-brand-bright); }
  .menu ul { position: absolute; right: 0; top: calc(100% + 8px); min-width: 220px; list-style: none; margin: 0; padding: var(--space-8); background: var(--color-surface); border: 1px solid var(--color-border-strong); border-radius: var(--radius-card); }
  .menu li a { display: flex; align-items: center; min-height: 44px; padding: 0 var(--space-12); }
  @media (max-width: 760px) {
    .links { display: none; }
    .menu { display: block; }
  }
</style>
